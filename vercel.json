{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|four-corners/|spelling-bee/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/spelling-bee/photos/:name.png",
      "destination": "/spelling-bee/photos/:name.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/games/state-lingo-bingo/answer-key",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
